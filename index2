<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edu-Z Inspire | System Update</title>
    <!-- تضمين مكتبة Tailwind CSS للتصميم -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- تضمين خط Poppins الاحترافي من جوجل -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    },
                    animation: {
                        'spin-slow': 'spin 8s linear infinite',
                        'loader-sweep': 'sweep 2s ease-in-out infinite',
                    },
                    keyframes: {
                        sweep: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(200%)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* تأثير الزجاج الشفاف */
        .glass-panel {
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        
        /* إضاءة الخلفية المتحركة */
        .ambient-light {
            animation: pulse-light 6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        
        @keyframes pulse-light {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.1); }
        }
    </style>
</head>
<!-- خلفية داكنة مع تدرج لوني احترافي -->
<body class="bg-slate-950 min-h-screen flex items-center justify-center relative overflow-hidden text-slate-200 antialiased selection:bg-blue-500/30">

    <!-- مؤثرات الإضاءة في الخلفية (Ambient Orbs) -->
    <div class="absolute top-[-15%] left-[-10%] w-96 h-96 bg-blue-600/30 rounded-full blur-[120px] ambient-light"></div>
    <div class="absolute bottom-[-15%] right-[-10%] w-96 h-96 bg-indigo-600/20 rounded-full blur-[120px] ambient-light" style="animation-delay: 3s;"></div>

    <!-- الكارت الرئيسي -->
    <div class="glass-panel p-10 sm:p-14 rounded-3xl z-10 max-w-lg w-full mx-5 text-center transform transition-all hover:scale-[1.01] duration-500">
        
        <!-- الأيقونة (ترس بيدور بيدل على العمل والصيانة) -->
        <div class="mb-8 flex justify-center">
            <div class="relative">
                <div class="absolute inset-0 bg-blue-500 rounded-full blur-lg opacity-40 animate-pulse"></div>
                <svg class="w-24 h-24 text-blue-400 relative z-10 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
            </div>
        </div>

        <!-- العنوان الرئيسي -->
        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 tracking-tight">We'll Be Right Back</h1>

        <!-- رسالة التوضيح -->
        <p class="text-slate-400 mb-8 leading-relaxed text-sm sm:text-base font-light">
            We are currently performing scheduled maintenance to upgrade <strong class="text-blue-400 font-medium">Edu-Z Inspire</strong>. We appreciate your patience and promise it will be worth the wait.
        </p>

        <!-- شريط التحميل (Loading Bar) -->
        <div class="w-full bg-slate-800/50 rounded-full h-1.5 mb-8 overflow-hidden backdrop-blur-sm border border-slate-700/50">
            <div class="h-1.5 rounded-full relative w-full overflow-hidden">
                <!-- الخط المتحرك جوا الشريط -->
                <div class="absolute top-0 bottom-0 left-0 bg-gradient-to-r from-transparent via-blue-500 to-transparent w-1/2 animate-loader-sweep"></div>
            </div>
        </div>

        <!-- الفوتر / حقوق الملكية -->
        <div class="text-xs text-slate-500 font-light flex flex-col gap-1">
            <span>&copy; <span id="currentYear"></span> Edu-Z Inspire System.</span>
            <span>All rights reserved.</span>
        </div>
    </div>

    <!-- كود بسيط لتحديث السنة تلقائياً -->
    <script>
        document.getElementById('currentYear').textContent = new Date().getFullYear();
    </script>
</body>
</html>
